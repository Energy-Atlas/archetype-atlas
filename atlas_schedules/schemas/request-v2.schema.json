{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas-schedules/request-v2",
  "title": "Schedule generator request 2.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "seed",
    "instances"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "instances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/instance"
      }
    },
    "mixture": {
      "$ref": "#/$defs/mixture"
    }
  },
  "$defs": {
    "extent": {
      "type": "object",
      "description": "Amount of each basis this instance represents: floor_area in m2, dwelling_unit, person or absolute counts.",
      "additionalProperties": false,
      "properties": {
        "floor_area": {
          "type": "number",
          "minimum": 0
        },
        "dwelling_unit": {
          "type": "number",
          "minimum": 0
        },
        "person": {
          "type": "number",
          "minimum": 0
        },
        "absolute": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "location": {
      "type": "object",
      "required": [
        "state",
        "latitude",
        "longitude",
        "utc_offset"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "utc_offset": {
          "type": "number",
          "minimum": -14,
          "maximum": 14
        }
      }
    },
    "instance": {
      "type": "object",
      "required": [
        "key"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/]+$",
          "description": "Unique instance key. '/' is reserved for owners the generator derives (apartment water, composition members)."
        },
        "program_id": {
          "type": "string",
          "pattern": "^program-[0-9a-f]{24}$"
        },
        "service_id": {
          "type": "string",
          "pattern": "^service-[0-9a-f]{24}$"
        },
        "configuration_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*(__[a-z0-9_]+)*$",
          "description": "Shared services: the ComStock configuration whose hours of operation they follow."
        },
        "physical_id": {
          "type": "string",
          "minLength": 1,
          "description": "Shared services: one physical fixture; repeated ids are counted once in mixtures."
        },
        "extent": {
          "$ref": "#/$defs/extent"
        },
        "multiplicity": {
          "type": "number",
          "minimum": 0,
          "default": 1
        },
        "operating_group": {
          "type": [
            "string",
            "null"
          ],
          "description": "Commercial instances sharing one sampled set of operating hours."
        },
        "residents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "Apartment units: residents N (0-20)."
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "service_links": {
          "type": "object",
          "propertyNames": {
            "pattern": "^service-[0-9a-f]{24}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Programmes: each required service id -> the key of a shared-service instance of that service."
        },
        "composition_basis": {
          "enum": [
            "reference_area",
            "caller_area"
          ],
          "description": "Composition parents: members keep their reference areas, or share the caller floor area."
        },
        "evidence": {
          "type": "string",
          "description": "Optional caller note on where extents come from."
        },
        "reference_location": {
          "enum": [
            "1A",
            "2A",
            "2B",
            "3A",
            "3B-CA",
            "3B-other",
            "3C",
            "4A",
            "4B",
            "4C",
            "5A",
            "5B",
            "6A",
            "6B",
            "7",
            "8"
          ],
          "description": "Residential and apartment instances: place the unit at a DOE Commercial Reference location (NREL/TP-5500-46861 Table 2); sets state, coordinates, time zone and TMY3 weather."
        }
      },
      "oneOf": [
        {
          "required": [
            "program_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "service_id"
                ]
              },
              {
                "required": [
                  "configuration_id"
                ]
              },
              {
                "required": [
                  "physical_id"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "service_id",
            "configuration_id",
            "physical_id"
          ],
          "not": {
            "required": [
              "program_id"
            ]
          }
        }
      ]
    },
    "mixture": {
      "type": "object",
      "required": [
        "program_id",
        "members"
      ],
      "additionalProperties": false,
      "properties": {
        "program_id": {
          "type": "string",
          "minLength": 1
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "instance",
              "weight"
            ],
            "additionalProperties": false,
            "properties": {
              "instance": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Shared service instances counted once, whole."
        },
        "result_basis": {
          "enum": [
            "floor_area",
            "dwelling_unit",
            "person",
            "absolute"
          ]
        },
        "denominator": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
