{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas-schedules/request-v3",
  "title": "Schedule generator request 3.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "seed",
    "instances"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "occupancy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Residential occupant-type mix: 'state' (default) weights ATUS cell probabilities by the dwelling state's household population (ACS); 'national' uses ResStock's national shares. window selects the ATUS years.",
      "properties": {
        "mix": {
          "enum": [
            "state",
            "national"
          ],
          "default": "state"
        },
        "window": {
          "enum": [
            "2003-2019",
            "2022-2024"
          ],
          "default": "2003-2019"
        }
      }
    },
    "instances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/instance"
      }
    },
    "mixture": {
      "$ref": "#/$defs/mixture"
    }
  },
  "$defs": {
    "extent": {
      "type": "object",
      "description": "Amount of each basis this instance represents: floor_area in m2, dwelling_unit, person or absolute counts.",
      "additionalProperties": false,
      "properties": {
        "floor_area": {
          "type": "number",
          "minimum": 0
        },
        "dwelling_unit": {
          "type": "number",
          "minimum": 0
        },
        "person": {
          "type": "number",
          "minimum": 0
        },
        "absolute": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "location": {
      "type": "object",
      "required": [
        "state",
        "latitude",
        "longitude",
        "utc_offset"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "utc_offset": {
          "type": "number",
          "minimum": -14,
          "maximum": 14
        },
        "climate_zone": {
          "enum": [
            "1A",
            "2A",
            "2B",
            "3A",
            "3B",
            "3C",
            "4A",
            "4B",
            "4C",
            "5A",
            "5B",
            "6A",
            "6B",
            "7A",
            "7AK",
            "7B",
            "8AK"
          ],
          "description": "IECC 2004 climate zone for ResStock apartment units; omitted, ResStock draws it within the state."
        },
        "weather_id": {
          "type": "string",
          "pattern": "^USA_[A-Z]{2}_[A-Za-z0-9.\\-]+_TMY3$",
          "description": "Packaged TMY3 station for ResStock apartment units (ceiling-fan months); omitted, the nearest station in the state."
        }
      }
    },
    "instance": {
      "type": "object",
      "required": [
        "key"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/]+$",
          "description": "Unique instance key. '/' is reserved for owners the generator derives (apartment water, composition members)."
        },
        "program_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+\\.[0-9a-f]{6}$",
          "description": "An atlas release program ID (ADR 0049); definition IDs (program-...) translate through the release's definition-map.json."
        },
        "values": {
          "enum": [
            "source",
            "filled"
          ],
          "description": "Programmes: the view of the program's values, as the two exports name them: source (actual values) or filled (actual values and fillings). Default: filled where the program's generation block has that view, else source."
        },
        "service_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+\\.[0-9a-f]{6}$",
          "description": "An atlas release service ID; definition IDs (service-...) translate through definition-map.json."
        },
        "configuration_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*(__[a-z0-9_]+)*$",
          "description": "Shared services: the ComStock configuration whose hours of operation they follow."
        },
        "physical_id": {
          "type": "string",
          "minLength": 1,
          "description": "Shared services: one physical fixture; repeated ids are counted once in mixtures."
        },
        "extent": {
          "$ref": "#/$defs/extent"
        },
        "multiplicity": {
          "type": "number",
          "minimum": 0,
          "default": 1
        },
        "operating_group": {
          "type": [
            "string",
            "null"
          ],
          "description": "Commercial instances sharing one sampled set of operating hours."
        },
        "residents": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 11
            },
            {
              "const": "resstock"
            }
          ],
          "description": "Apartment units: residents N per dwelling unit, 0-11 (ResStock samples 0-9 and '10+', which it runs as 11). With \"resstock\", ResStock draws the residents of a ResStock apartment unit (vacancy included)."
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "service_links": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+\\.[0-9a-f]{6}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Programmes: each required service id -> the key of a shared-service instance of that service."
        },
        "composition_basis": {
          "enum": [
            "reference_area",
            "caller_area"
          ],
          "description": "Composition parents: members keep their reference areas, or share the caller floor area."
        },
        "evidence": {
          "type": "string",
          "description": "Optional caller note on where extents come from."
        },
        "reference_location": {
          "enum": [
            "1A",
            "2A",
            "2B",
            "3A",
            "3B-CA",
            "3B-other",
            "3C",
            "4A",
            "4B",
            "4C",
            "5A",
            "5B",
            "6A",
            "6B",
            "7",
            "8"
          ],
          "description": "Residential and apartment instances: place the unit at a DOE Commercial Reference location (NREL/TP-5500-46861 Table 2); sets state, coordinates, time zone and TMY3 weather."
        }
      },
      "oneOf": [
        {
          "required": [
            "program_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "service_id"
                ]
              },
              {
                "required": [
                  "configuration_id"
                ]
              },
              {
                "required": [
                  "physical_id"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "service_id",
            "configuration_id",
            "physical_id"
          ],
          "not": {
            "required": [
              "program_id"
            ]
          }
        }
      ]
    },
    "mixture": {
      "type": "object",
      "required": [
        "program_id",
        "members"
      ],
      "additionalProperties": false,
      "properties": {
        "program_id": {
          "type": "string",
          "minLength": 1
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "instance",
              "weight"
            ],
            "additionalProperties": false,
            "properties": {
              "instance": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Shared service instances counted once, whole."
        },
        "result_basis": {
          "enum": [
            "floor_area",
            "dwelling_unit",
            "person",
            "absolute"
          ]
        },
        "denominator": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
