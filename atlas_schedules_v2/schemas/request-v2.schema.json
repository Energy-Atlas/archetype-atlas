{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas-schedules/request-v2",
  "title": "Schedule generator request 2.0.0",
  "type": "object",
  "required": ["schema_version", "seed", "instances"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "residential_rng": {"enum": ["pcg64", "ruby_mt"], "default": "pcg64"},
    "instances": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/instance"}},
    "mixture": {"$ref": "#/$defs/mixture"}
  },
  "$defs": {
    "extent": {
      "type": "object",
      "description": "Amount of each basis this instance represents: floor_area in m2, dwelling_unit, person or absolute counts.",
      "additionalProperties": false,
      "properties": {
        "floor_area": {"type": "number", "minimum": 0},
        "dwelling_unit": {"type": "number", "minimum": 0},
        "person": {"type": "number", "minimum": 0},
        "absolute": {"type": "number", "minimum": 0}
      }
    },
    "location": {
      "type": "object",
      "required": ["state", "latitude", "longitude", "utc_offset"],
      "additionalProperties": false,
      "properties": {
        "state": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "utc_offset": {"type": "number", "minimum": -14, "maximum": 14}
      }
    },
    "instance": {
      "type": "object",
      "required": ["key"],
      "additionalProperties": false,
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "program_id": {"type": "string", "minLength": 1},
        "service_id": {"type": "string", "minLength": 1},
        "configuration_id": {"type": "string", "minLength": 1,
                             "description": "Shared services: the ComStock configuration whose hours of operation they follow."},
        "physical_id": {"type": "string", "minLength": 1,
                        "description": "Shared services: one physical fixture; repeated ids are counted once in mixtures."},
        "extent": {"$ref": "#/$defs/extent"},
        "multiplicity": {"type": "number", "minimum": 0, "default": 1},
        "operating_group": {"type": ["string", "null"],
                            "description": "Commercial instances sharing one sampled set of operating hours."},
        "residents": {"type": "integer", "minimum": 0, "description": "Apartment units: residents N."},
        "location": {"$ref": "#/$defs/location"},
        "service_links": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1},
                          "description": "Programmes: required service id -> shared service instance key."},
        "composition_basis": {"enum": ["reference_area", "caller_area"],
                              "description": "Composition parents: members keep their reference areas, or share the caller floor area."},
        "evidence": {"type": "string", "description": "Optional caller note on where extents come from."}
      },
      "oneOf": [{"required": ["program_id"]}, {"required": ["service_id", "configuration_id", "physical_id"]}]
    },
    "mixture": {
      "type": "object",
      "required": ["program_id", "members"],
      "additionalProperties": false,
      "properties": {
        "program_id": {"type": "string", "minLength": 1},
        "members": {"type": "array", "items": {
          "type": "object", "required": ["instance", "weight"], "additionalProperties": false,
          "properties": {"instance": {"type": "string"}, "weight": {"type": "number", "minimum": 0}}}},
        "services": {"type": "array", "items": {"type": "string"},
                     "description": "Shared service instances counted once, whole."},
        "result_basis": {"enum": ["floor_area", "dwelling_unit", "person", "absolute"]},
        "denominator": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
