{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas static query artifacts 1.0.0",
  "oneOf": [
    {"$ref": "#/$defs/latest"}, {"$ref": "#/$defs/manifest"},
    {"$ref": "#/$defs/index"}, {"$ref": "#/$defs/packet"},
    {"$ref": "#/$defs/evidence"}, {"$ref": "#/$defs/schedule"}
  ],
  "$defs": {
    "version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["href", "sha256", "size_bytes"],
      "properties": {
        "href": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 100000000},
        "encoding": {"const": "gzip"},
        "decoded_size_bytes": {"type": "integer", "minimum": 0, "maximum": 16000000}
      },
      "dependentRequired": {"encoding": ["decoded_size_bytes"], "decoded_size_bytes": ["encoding"]}
    },
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "unit", "status", "evidence_pointer"],
      "properties": {
        "value": {}, "unit": {"type": ["string", "null"]},
        "status": {"enum": ["source", "unknown", "reviewed"]},
        "evidence_pointer": {"type": "string", "pattern": "^/"},
        "resource": {"$ref": "#/$defs/reference"}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "fields", "reviewed", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "fields": {"type": "object", "additionalProperties": {"$ref": "#/$defs/field"}},
        "reviewed": {"type": "object", "additionalProperties": {"$ref": "#/$defs/field"}},
        "evidence": {"$ref": "#/$defs/reference"}
      }
    },
    "latest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "snapshot_id", "manifest"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/version"}, "kind": {"const": "latest"},
        "snapshot_id": {"$ref": "#/$defs/hash"}, "manifest": {"$ref": "#/$defs/reference"}
        ,"history": {"$ref": "#/$defs/reference"}
      }
    },
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "snapshot_id", "dependencies", "record_types", "schemas", "notices", "max_packet_bytes", "views"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/version"}, "kind": {"const": "manifest"},
        "snapshot_id": {"$ref": "#/$defs/hash"},
        "dependencies": {"type": "object", "minProperties": 1, "additionalProperties": {
          "type": "object", "additionalProperties": false, "required": ["version", "manifest_sha256"],
          "properties": {"version": {"type": "string"}, "manifest_sha256": {"$ref": "#/$defs/hash"}}
        }},
        "record_types": {"type": "object", "additionalProperties": {
          "type": "object", "additionalProperties": false, "required": ["record_count", "fields", "filter_fields", "index"],
          "properties": {
            "record_count": {"type": "integer", "minimum": 0},
            "fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "filter_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "index": {"$ref": "#/$defs/reference"}
          }
        }},
        "schemas": {"type": "object", "additionalProperties": {"$ref": "#/$defs/reference"}},
        "notices": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "resource"],
          "properties": {"name": {"type": "string"}, "resource": {"$ref": "#/$defs/reference"}}
        }},
        "max_packet_bytes": {"type": "integer", "minimum": 1, "maximum": 131072},
        "views": {"const": ["source", "reviewed"]}
      }
    },
    "index": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "record_type", "routes"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/version"}, "kind": {"const": "index"},
        "record_type": {"type": "string"},
        "routes": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["selectors", "record_ids", "packets"],
          "properties": {
            "record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
            "selectors": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}},
            "packets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}}
          }
        }}
      }
    },
    "packet": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "record_type", "records"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/version"}, "kind": {"const": "packet"},
        "record_type": {"type": "string"},
        "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "record", "provenance", "resolutions", "source_files"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/version"}, "kind": {"const": "evidence"},
        "record": {"type": "object"}, "provenance": {"type": ["object", "null"]},
        "resolutions": {"type": "object"}, "source_files": {"type": "array", "items": {"type": "object"}}
      }
    },
    "schedule": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "representation", "record"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/version"}, "kind": {"const": "schedule"},
        "representation": {"enum": ["rules", "constant", "annual_series", "fixed_profiles"]},
        "evidence": {"$ref": "#/$defs/reference"},
        "record": {"type": "object"}
      }
    }
  }
}
