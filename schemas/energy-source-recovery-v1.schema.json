{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent construction/system source recovery inputs v1",
  "type": "object",
  "required": ["schema_version", "kind", "extraction_date", "input_sha256", "source_files", "residential_source_files", "runtime", "boundary", "records"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"enum": ["construction_recovery", "system_recovery"]},
    "extraction_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "input_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "source_files": {"type": "object"},
    "residential_source_files": {"type": "object"},
    "runtime": {"type": "object"},
    "boundary": {"type": "string", "minLength": 1},
    "records": {"type": "object", "additionalProperties": {"$ref": "#/$defs/record"}},
    "materials": {"type": "object", "additionalProperties": {"type": "object", "required": ["id", "fields"], "properties": {"fields": {"$ref": "#/$defs/fields"}}}},
    "water_heaters": {"type": "object", "additionalProperties": {"type": "object", "required": ["id", "role", "fields", "unresolved", "required_bindings", "readiness"], "properties": {"fields": {"$ref": "#/$defs/fields"}, "role": {"enum": ["water_heater", "solar_thermal"]}}}}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "construction_recovery"}}}, "then": {"required": ["materials"], "not": {"required": ["water_heaters"]}}},
    {"if": {"properties": {"kind": {"const": "system_recovery"}}}, "then": {"required": ["water_heaters"], "not": {"required": ["materials"]}}}
  ],
  "$defs": {
    "record": {
      "type": "object",
      "required": ["id", "source_id", "source_context", "recovered", "unresolved", "required_bindings", "readiness"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "source_context": {"type": "object"},
        "recovered": {"type": "object"},
        "unresolved": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_bindings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "readiness": {"enum": ["resolved", "requires_bindings", "blocked"]}
      }
    },
    "fields": {"type": "object", "additionalProperties": {"$ref": "#/$defs/operand"}},
    "operand": {
      "type": "object",
      "required": ["value", "unit", "status", "origin", "evidence"],
      "properties": {
        "value": {"type": ["number", "string", "boolean", "null"]},
        "unit": {"type": "string", "minLength": 1},
        "status": {"enum": ["known", "unknown"]},
        "origin": {"enum": ["source", "source_default", "source_calculation"]},
        "evidence": {
          "type": "object",
          "required": ["source_project", "source_revision", "source_file_sha256", "source_locator", "original_value", "original_unit", "transformation", "extraction_date", "interpretation_note"],
          "properties": {
            "source_file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "source_locator": {"type": "string", "minLength": 1},
            "original_unit": {"type": "string", "minLength": 1},
            "transformation": {"type": "string", "minLength": 1},
            "interpretation_note": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
