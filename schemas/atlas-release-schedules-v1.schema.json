{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archetype-atlas:atlas-release-schedules:1.0.0",
  "$comment": "revision 1 (2026-11-01). Versioning: docs/schema-versioning.md; revisions and hashes: schemas/revisions.json.",
  "title": "Atlas release folder schedules.json 1.0.0",
  "description": "A building folder's schedule table (ADR 0036 section 3, ADR 0046 P9): distinct day profiles by ID (24 hourly values or one constant), and the folder's schedules by release ID, each an ordered list of rules (day selector, date range, day profile, source order). Rule dates, day selectors and source order are kept as the source states them.",
  "type": "object",
  "required": ["days", "schedules"],
  "additionalProperties": false,
  "properties": {
    "days": {
      "type": "object",
      "propertyNames": {"pattern": "^d-[0-9a-f]{8}$"},
      "additionalProperties": {"type": "array", "items": {"type": "number"}, "oneOf": [{"minItems": 1, "maxItems": 1}, {"minItems": 24, "maxItems": 24}]}
    },
    "schedules": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9.-]*\\.[0-9a-f]{6}$"},
      "additionalProperties": {"$ref": "#/$defs/schedule"}
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["day", "day_types", "start_date", "end_date", "source_index"],
      "additionalProperties": false,
      "properties": {
        "day": {"type": "string", "pattern": "^d-[0-9a-f]{8}$"},
        "day_types": {"type": "string", "minLength": 1},
        "start_date": {"type": "string"},
        "end_date": {"type": "string"},
        "source_index": {"type": "integer", "minimum": 0},
        "type": {"type": "string"},
        "source_category": {"type": ["string", "null"]},
        "source_units": {"type": ["string", "null"]}
      }
    },
    "schedule": {
      "type": "object",
      "required": ["rules", "schedule_type", "time_resolution_minutes", "units"],
      "additionalProperties": false,
      "properties": {
        "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}},
        "schedule_type": {"type": "string"},
        "time_resolution_minutes": {"type": "integer", "minimum": 1},
        "units": {"type": ["string", "null"]},
        "name": {"type": "string"},
        "source_name": {"type": "string"},
        "calendar": {"type": ["object", "string"]},
        "derivation": {"type": ["string", "object"]},
        "interpolation": {"type": "string"},
        "interpretation_note": {"type": "string"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "provenance_id": {"type": "string"},
        "type_limits": {"type": ["object", "string", "null"]},
        "peak_divisor": {"type": "number", "exclusiveMinimum": 0}
      },
      "anyOf": [{"required": ["name"]}, {"required": ["source_name"]}]
    }
  }
}
