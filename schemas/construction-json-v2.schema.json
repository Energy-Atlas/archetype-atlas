                  "const": {
                    "surface_type": "TubularDaylightDome"
                  }
                }
              }
            }
          ]
        },
        "TubularDaylightDiffuser": {
          "allOf": [
            {
              "$ref": "#/$defs/component"
            },
            {
              "properties": {
                "target": {
                  "const": {
                    "surface_type": "TubularDaylightDiffuser"
                  }
                }
              }
            }
          ]
        },
        "SpaceShading": {
          "allOf": [
            {
              "$ref": "#/$defs/component"
            },
            {
              "properties": {
                "target": {
                  "const": {
                    "object_type": "Shading",
                    "shading_scope": "space"
                  }
                }
              }
            }
          ]
        },
        "BuildingShading": {
          "allOf": [
            {
              "$ref": "#/$defs/component"
            },
            {
              "properties": {
                "target": {
                  "const": {
                    "object_type": "Shading",
                    "shading_scope": "building"
                  }
                }
              }
            }
          ]
        },
        "SiteShading": {
          "allOf": [
            {
              "$ref": "#/$defs/component"
            },
            {
              "properties": {
                "target": {
                  "const": {
                    "object_type": "Shading",
