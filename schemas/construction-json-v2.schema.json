                      "Outdoors"
                    ]
                  }
                }
              }
            }
          ]
        },
        "Skylight": {
          "allOf": [
            {
              "$ref": "#/$defs/component"
            },
            {
              "properties": {
                "target": {
                  "const": {
                    "surface_type": "Skylight",
                    "boundary_conditions": [
                      "Outdoors"
                    ]
                  }
                }
              }
            }
          ]
        },
        "InteriorWall": {
          "allOf": [
            {
              "$ref": "#/$defs/component"
            },
            {
              "properties": {
                "target": {
                  "const": {
                    "surface_type": "Wall",
                    "boundary_conditions": [
                      "Surface",
                      "Adiabatic"
                    ]
                  }
                }
              }
            }
          ]
        },
        "InteriorFloor": {
          "allOf": [
            {
              "$ref": "#/$defs/component"
            },
            {
              "properties": {
                "target": {
                  "const": {
                    "surface_type": "Floor",
                    "boundary_conditions": [
                      "Surface",
                      "Adiabatic"
                    ]
                  }
                }
              }
            }
          ]
        },
        "InteriorCeiling": {
          "allOf": [
            {
              "$ref": "#/$defs/component"
            },
            {
              "properties": {
                "target": {
                  "const": {
                    "surface_type": "Ceiling",
                    "boundary_conditions": [
                      "Surface",
                      "Adiabatic"
                    ]
                  }
                }
              }
            }
          ]
        },
        "InteriorDoor": {
          "allOf": [
            {
              "$ref": "#/$defs/component"
            },
            {
              "properties": {
                "target": {
                  "const": {
                    "surface_type": "Door",
                    "boundary_conditions": [
                      "Surface",
                      "Adiabatic"
                    ]
                  }
                }
              }
            }
          ]
        },
        "InteriorWindow": {
          "allOf": [
            {
              "$ref": "#/$defs/component"
            },
            {
              "properties": {
