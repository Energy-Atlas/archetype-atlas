      },
      "required": [
        "ExteriorWall",
        "ExteriorRoof",
        "ExteriorFloor",
        "ExteriorWindow",
        "ExteriorDoor",
        "GlassDoor",
        "OverheadDoor",
        "Skylight",
        "InteriorWall",
        "InteriorFloor",
        "InteriorCeiling",
        "InteriorDoor",
        "InteriorWindow",
        "InteriorPartition",
        "TubularDaylightDome",
        "TubularDaylightDiffuser",
        "SpaceShading",
        "BuildingShading",
        "SiteShading"
      ]
    },
    "infiltration": {
      "$ref": "#/$defs/infiltration"
    },
    "assemblies": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/assembly"
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/material"
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/evidence"
      }
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "export_mode",
    "id",
    "name",
    "scope",
    "source",
    "components",
    "infiltration",
    "assemblies",
    "materials",
    "evidence",
    "metadata"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archetype-atlas:construction-json:2.0.0",
  "title": "Unified selected above-ground construction set 2.0.0",
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_project": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "source_locator": {
          "type": "string",
          "minLength": 1
        },
        "source_file_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          ]
        },
        "original_value": {},
        "original_unit": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "transformation": {
          "type": "string",
          "minLength": 1
        },
        "extraction_date": {
          "type": "string",
          "format": "date"
        },
        "interpretation_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "source_project",
        "source_revision",
        "source_locator",
        "source_file_sha256",
        "original_value",
        "original_unit",
        "transformation",
        "extraction_date",
        "interpretation_note"
      ],
      "additionalProperties": true
    },
    "material": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "enum": [
            "StandardOpaqueMaterial",
            "MasslessOpaqueMaterial",
            "AirGap",
            "Gas",
            "StandardGlazing",
            "SimpleGlazing"
          ]
        },
        "properties": {
          "type": "object",
          "minProperties": 1
        },
        "property_evidence": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "name",
        "model",
        "properties",
        "property_evidence"
      ],
      "additionalProperties": false
    },
    "assembly": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "enum": [
            "opaque_layers",
            "simple_glazing",
            "detailed_glazing"
          ]
        },
        "status": {
          "const": "ready"
        },
        "source_family": {
          "type": "string",
          "minLength": 1
        },
        "template": {
          "type": [
            "string",
            "null"
          ]
        },
        "climate_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "order": {
                "type": "integer",
                "minimum": 0
              },
              "material_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "order",
              "material_id"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "layer_orientation": {
          "const": "exterior_to_interior"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "applicability": {
          "type": "object"
        },
        "source_attributes": {
          "type": "object"
        },
        "source_surface_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_adjacency": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "source_parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/parameter"
          }
        },
        "target_adjustment": {
          "type": [
            "object",
            "null"
          ]
        },
        "solar_modifiers": {
          "type": "object"
        },
        "source_fixture_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "model",
        "status",
        "source_family",
        "template",
        "climate_group",
        "layers",
        "layer_orientation",
        "evidence_ids",
        "applicability",
        "source_attributes",
        "source_surface_ids",
        "source_adjacency",
        "metrics",
        "source_parameters",
        "target_adjustment"
      ],
      "additionalProperties": false
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": [
            "building_default",
            "space_type",
            "whole_dwelling"
          ]
        },
        "space_type": {
          "type": "string",
          "minLength": 1
        },
        "window_operation": {
          "enum": [
            "fixed",
            "operable"
          ]
        },
        "interior_space_type": {
          "type": "string",
          "minLength": 1
        },
        "exterior_space_type": {
          "type": "string",
          "minLength": 1
        },
        "boundary_condition": {
          "enum": [
            "Outdoors",
            "Surface",
            "Adiabatic"
          ]
        }
      },
      "required": [
        "scope"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "space_type"
              }
            }
          },
          "then": {
            "required": [
              "space_type"
            ]
          },
          "else": {
            "not": {
              "required": [
                "space_type"
              ]
            }
          }
        }
      ]
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "bem_surface_area",
            "source_partition_cfa_scaling",
            "source_ordinary_interstory_scaling"
          ]
        },
        "unit": {
          "const": "m2"
        },
        "area_per_conditioned_floor_area": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "area_convention": {
          "type": "string",
          "minLength": 1
        },
        "source_area_rule": {
          "type": "string",
          "minLength": 1
        },
        "paired_floor_and_ceiling": {
          "const": true
        },
        "source_activation_threshold_m2": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "method",
        "unit"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "source_partition_cfa_scaling"
              }
            }
          },
          "then": {
            "required": [
              "area_per_conditioned_floor_area",
              "area_convention"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "source_ordinary_interstory_scaling"
              }
            }
          },
          "then": {
            "required": [
              "source_area_rule",
              "paired_floor_and_ceiling",
              "source_activation_threshold_m2"
            ]
          }
        }
      ]
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "area": {
          "$ref": "#/$defs/area"
        },
        "layers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "orientation": {
              "const": "exterior_to_interior"
            },
            "paired_surface_policy": {
              "const": "reverse_order"
            },
            "source_reference_reversed": {
              "type": "boolean"
            }
          },
          "required": [
            "orientation",
            "paired_surface_policy",
            "source_reference_reversed"
          ]
        },
        "roof": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_pitch_rad": {
              "type": "number",
              "minimum": 0,
              "maximum": 1.5707963267948966
            },
            "unit": {
              "const": "rad"
            },
            "applicability": {
              "const": "source_pitch_only"
            },
            "different_pitch_policy": {
              "const": "source_recipe_reevaluation_required"
            },
            "source_film_rule": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "source_pitch_rad",
            "unit",
            "applicability",
            "different_pitch_policy",
            "source_film_rule"
          ]
        },
        "overhang": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "depth_m": {
              "type": "number"
            },
            "distance_to_top_of_window_m": {
              "type": "number"
            },
            "distance_to_bottom_of_window_m": {
              "type": "number"
            },
            "evidence_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "depth_m",
            "distance_to_top_of_window_m",
            "distance_to_bottom_of_window_m",
            "evidence_id"
          ]
        }
      },
      "required": [
        "area",
        "layers"
      ]
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "assembly_id": {
          "type": "string",
          "minLength": 1
        },
        "source_definition_id": {
          "type": "string",
          "minLength": 1
        },
        "source_selector": {
          "type": [
            "string",
            "null"
          ]
        },
        "when": {
          "$ref": "#/$defs/when"
        },
        "source_element_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": [
        "id",
        "assembly_id",
        "source_definition_id",
        "source_selector",
        "when",
        "source_element_ids",
        "geometry",
        "evidence_ids"
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "enum": [
            "provided",
            "source_absent"
          ]
        },
        "assignments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assignment"
          }
        },
        "target": {
          "type": "object"
        }
      },
      "required": [
        "disposition",
        "assignments",
        "target"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "construction_set_id": {
          "type": "string",
          "minLength": 1
        },
        "definition_release": {
          "type": "string",
          "minLength": 1
        },
        "building_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "template": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_view": {
          "enum": [
            "source",
            "reviewed"
          ]
        },
        "source_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "climate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "exact"
            },
            "value": {
              "enum": [
                "0A",
                "0B",
                "1A",
                "1B",
                "2A",
                "2B",
                "3A",
                "3B",
                "3C",
                "4A",
                "4B",
                "4C",
                "5A",
                "5B",
                "5C",
                "6A",
                "6B",
                "7A",
                "7B",
                "8A",
                "8B"
              ]
            }
          },
          "required": [
            "status",
            "value"
          ]
        },
        "vintage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "exact"
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "source_template",
                "stock_vintage"
              ]
            }
          },
          "required": [
            "status",
            "value",
            "kind"
          ]
        },
        "space_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference_variant_id": {
          "type": "string",
          "minLength": 1
        },
        "source_fixture_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_climate_label": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "construction_set_id",
        "definition_release",
        "building_type",
        "template",
        "evidence_view",
        "source_family",
        "climate",
        "vintage",
        "space_type",
        "reference_variant_id",
        "source_fixture_id",
        "evidence"
      ]
    },
    "ach": {
