          "space": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "template",
          "building_type",
          "space",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "programs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/programs"
      }
