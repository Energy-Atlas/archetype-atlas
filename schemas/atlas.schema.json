    "schedules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/schedules"
      }
    },
    "envelope_components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/envelope_components"
      }
    },
    "systems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/systems"
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mappings"
      }
    },
    "efficiency_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/efficiency_rules"
      }
    },
    "residential_options": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/residential_options"
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provenance"
      }
    },
    "source_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_files"
      }
    },
    "commercial_options": {
      "type": "array",
