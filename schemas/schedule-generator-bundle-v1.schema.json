{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archetype-atlas:schedule-generator-bundle:1.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "algorithm_version",
    "schedules",
    "bindings",
    "constituents",
    "generation",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "algorithm_version": {
      "type": "string",
      "minLength": 1
    },
    "schedules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "unit",
          "year",
          "clock",
          "timestep_minutes",
          "values"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999
          },
          "clock": {
            "const": "local_standard_time"
          },
          "timestep_minutes": {
            "const": 60
          },
          "values": {
            "type": "array",
            "minItems": 8760,
            "maxItems": 8760,
            "items": {
              "type": "number"
            }
          },
          "source_precision_significant_digits": {
            "type": "integer",
            "minimum": 1,
            "maximum": 17
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "constituents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "instance_key",
          "program_id",
          "recipe_id",
          "source",
          "inputs",
          "slots",
          "demands",
          "controls",
          "shared_services",
          "evidence",
          "schedule_ids",
          "binding_indices",
          "generation"
        ],
        "additionalProperties": false,
        "properties": {
          "instance_key": {
            "type": "string",
            "minLength": 1
          },
          "program_id": {
            "type": "string",
            "minLength": 1
          },
          "recipe_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "required": ["source_family", "source_id", "template", "vintage", "evidence_view", "weather"],
            "additionalProperties": true,
            "properties": {
              "source_family": {"type": "string", "minLength": 1},
              "source_id": {"type": "string", "minLength": 1},
              "template": {"type": ["string", "null"]},
              "vintage": {"type": ["string", "null"]},
              "evidence_view": {"type": "string", "minLength": 1},
              "weather": {"type": ["string", "object", "null"]}
            }
          },
          "inputs": {
            "type": "object"
          },
          "slots": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "demands": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "shared_services": {
            "type": "array"
          },
          "evidence": {
            "type": "array"
          },
          "schedule_ids": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "binding_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "generation": {
            "type": "object"
          }
        }
      }
    },
    "generation": {
      "type": "object"
    },
    "metadata": {
      "type": "object",
      "required": [
        "resource_set_id",
        "calendar"
      ],
      "properties": {
        "resource_set_id": {
          "type": "string",
          "minLength": 1
        },
        "calendar": {
          "type": "object",
          "required": [
            "year",
            "clock"
          ],
          "additionalProperties": false,
          "properties": {
            "year": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999
            },
            "clock": {
              "const": "local_standard_time"
            },
            "holidays": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            }
          }
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "minProperties": 1
    },
    "magnitude": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "basis"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "quantity",
        "total",
        "unit",
        "basis",
        "method",
        "magnitude_unit",
        "fuel",
        "host",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "type": "string",
          "minLength": 1
        },
        "total": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": [
            "direct_annual",
            "reference_schedule"
          ]
        },
        "magnitude_unit": {
          "type": "string",
          "minLength": 1
        },
        "fuel": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "original_magnitude": {
          "type": "object",
          "required": [
            "value",
            "unit",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "unit": {
              "type": "string"
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        "installed_rating": {
          "type": "object"
        },
        "capacity_constraint": {
          "type": "object",
          "required": [
            "maximum",
            "unit",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "maximum": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "type": "string"
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "receipt": {
      "type": "object",
      "required": [
        "generated_integral",
        "seconds_per_sample",
        "achieved_total",
        "unit"
      ],
      "additionalProperties": false,
      "properties": {
        "generated_integral": {
          "type": "number",
          "minimum": 0
        },
        "seconds_per_sample": {
          "const": 3600
        },
        "achieved_total": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "capacity_constraint": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "load": {
      "type": "object",
      "required": [
        "kind",
        "instance_key",
        "program_id",
        "demand_id",
        "slot",
        "schedule_id",
        "fuel",
        "host",
        "budget_method",
        "reference_target",
        "effective_magnitude",
        "scaling_receipt"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "load"
        },
        "instance_key": {
          "type": "string",
          "minLength": 1
        },
        "program_id": {
          "type": "string",
          "minLength": 1
        },
        "demand_id": {
          "type": "string",
          "minLength": 1
        },
        "slot": {
          "type": "string",
          "minLength": 1
        },
        "schedule_id": {
          "type": "string",
          "minLength": 1
        },
        "fuel": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "budget_method": {
          "enum": [
            "direct_annual",
            "reference_schedule"
          ]
        },
        "reference_target": {
          "$ref": "#/$defs/target"
        },
        "effective_magnitude": {
          "$ref": "#/$defs/magnitude"
        },
        "scaling_receipt": {
          "$ref": "#/$defs/receipt"
        }
      }
    },
    "control": {
      "type": "object",
      "required": [
        "kind",
        "instance_key",
        "program_id",
        "slot",
        "schedule_id",
        "control_quantity"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "control"
        },
        "instance_key": {
          "type": "string",
          "minLength": 1
        },
        "program_id": {
          "type": "string",
          "minLength": 1
        },
        "slot": {
          "type": "string",
          "minLength": 1
        },
        "schedule_id": {
          "type": "string",
          "minLength": 1
        },
        "control_quantity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "binding": {
      "oneOf": [
        {
          "$ref": "#/$defs/load"
        },
        {
          "$ref": "#/$defs/control"
        }
      ]
    }
  }
}
