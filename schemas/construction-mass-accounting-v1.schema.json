{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archetype-atlas:construction-mass-accounting:1.0.0",
  "title": "Shared source construction mass accounting",
  "$ref": "#/$defs/massAccounting",
  "$defs": {
    "massLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "properties"
      ],
      "properties": {
        "model": {
          "enum": [
            "StandardOpaqueMaterial",
            "MasslessOpaqueMaterial",
            "AirGap"
          ]
        },
        "properties": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "massRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "layers",
        "capacity_J_m2_K",
        "source_locator",
        "interpretation"
      ],
      "properties": {
        "model": {
          "const": "opaque_layers"
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/massLayer"
          }
        },
        "capacity_J_m2_K": {
          "type": "number",
          "minimum": 0
        },
        "source_locator": {
          "type": "string",
          "minLength": 1
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "massScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "counted_floor_area"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source_space",
            "whole_dwelling"
          ]
        },
        "counted_floor_area": {
          "type": "boolean"
        },
        "source_space_name": {
          "type": "string",
          "minLength": 1
        },
        "source_story": {
          "type": [
            "string",
            "null"
          ]
        },
        "native_building_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "native_space_type": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "massEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "recipe_id",
        "scope",
        "reference_area_m2",
        "area_per_counted_floor_area",
        "capacity_per_counted_floor_area_J_m2_K",
        "source_operands",
        "source_locator",
        "area_convention"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "recipe_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/massScope"
        },
        "reference_area_m2": {
          "type": "number",
          "minimum": 0
        },
        "area_per_counted_floor_area": {
          "type": "number",
          "minimum": 0
        },
        "capacity_per_counted_floor_area_J_m2_K": {
          "type": "number",
          "minimum": 0
        },
        "source_operands": {
          "type": "object"
        },
        "source_locator": {
          "type": "string",
          "minLength": 1
        },
        "area_convention": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "massBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_assembly_id",
        "area_per_counted_floor_area",
        "capacity_per_counted_floor_area_J_m2_K",
        "reference_area_m2",
        "source_areal_capacity_J_m2_K",
        "source_locator"
      ],
      "properties": {
        "source_assembly_id": {
          "type": "string",
          "minLength": 1
        },
        "area_per_counted_floor_area": {
          "type": "number",
          "minimum": 0
        },
        "capacity_per_counted_floor_area_J_m2_K": {
          "type": "number",
          "minimum": 0
        },
        "reference_area_m2": {
          "type": "number",
          "minimum": 0
        },
        "source_areal_capacity_J_m2_K": {
          "type": "number",
          "minimum": 0
        },
        "source_locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "massAccounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "reference",
        "floor_pair_policy",
        "added_mass_policy",
        "removed_wall_policy",
        "residual_floor_policy",
        "residual_policy",
        "physical_inventory_profile_id",
        "paired_surface_policy",
        "paired_face_area_policy",
        "reference_area_approximation",
        "physical_capacity_budgets",
        "additional_mass",
        "recipes",
        "provenance"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "status": {
          "const": "ready"
        },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_id",
            "counted_floor_area_m2",
            "quantity_basis"
          ],
          "properties": {
            "profile_id": {
              "type": "string",
              "minLength": 1
            },
            "counted_floor_area_m2": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "quantity_basis": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "floor_pair_policy": {
          "type": "string",
          "minLength": 1
        },
        "added_mass_policy": {
          "type": "string",
          "minLength": 1
        },
        "removed_wall_policy": {
          "type": "string",
          "minLength": 1
        },
        "residual_floor_policy": {
          "type": "string",
          "minLength": 1
        },
        "residual_policy": {
          "type": "string",
          "minLength": 1
        },
        "physical_inventory_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "paired_surface_policy": {
          "const": {
            "canonical_side": "InteriorFloor",
            "adjacent_ceiling": "reverse the same canonical floor assembly",
            "unpaired_ceiling": "use InteriorCeiling recipe"
          }
        },
        "paired_face_area_policy": {
          "const": "mean_zone_weighted_faces"
        },
        "reference_area_approximation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unequal_multiplier_pair_counts",
            "evidence_profile_id",
            "interpretation"
          ],
          "properties": {
            "unequal_multiplier_pair_counts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "floor_pairs",
                "wall_pairs"
              ],
              "properties": {
                "floor_pairs": {
                  "type": "integer",
                  "minimum": 0
                },
                "wall_pairs": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "evidence_profile_id": {
              "type": "string",
              "minLength": 1
            },
            "interpretation": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "physical_capacity_budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "InteriorWall",
            "InteriorFloor"
          ],
          "properties": {
            "InteriorWall": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/massBudget"
              }
            },
            "InteriorFloor": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/massBudget"
              }
            }
          }
        },
        "additional_mass": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "entries",
            "allocation_policy",
            "legacy_partition_selector_policy"
          ],
          "properties": {
            "status": {
              "enum": [
                "provided",
                "known_zero"
              ]
            },
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/massEntry"
              }
            },
            "allocation_policy": {
              "type": "string",
              "minLength": 1
            },
            "legacy_partition_selector_policy": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "recipes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/massRecipe"
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_project",
            "source_revision",
            "source_locator",
            "source_file_sha256",
            "extraction_date",
            "original_unit",
            "original_value",
            "transformation",
            "interpretation_note"
          ],
          "properties": {
            "source_project": {
              "type": "string",
              "minLength": 1
            },
            "source_revision": {
              "type": "string",
              "minLength": 1
            },
            "source_locator": {
              "type": "string",
              "minLength": 1
            },
            "source_file_sha256": {
              "type": "object"
            },
            "extraction_date": {
              "type": "string",
              "minLength": 1
            },
            "original_unit": {
              "type": "string",
              "minLength": 1
            },
            "original_value": {
              "type": "object"
            },
            "transformation": {
              "type": "string",
              "minLength": 1
            },
            "interpretation_note": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
