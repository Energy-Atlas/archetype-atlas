                    "const": true
                  }
                }
              },
              "then": {
                "required": [
                  "heating_setpoint_schedule_id"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "heating_setpoint_schedule_id"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "cooling_enabled": {
                    "const": true
                  }
                }
              },
              "then": {
                "required": [
                  "cooling_setpoint_schedule_id"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "cooling_setpoint_schedule_id"
                  ]
                }
              }
            }
          ],
          "oneOf": [
            {
              "properties": {
                "heating_enabled": {
                  "const": false
                },
                "cooling_enabled": {
                  "const": false
                },
                "conditioning_state": {
                  "const": "unconditioned"
                }
              }
            },
            {
              "properties": {
                "heating_enabled": {
                  "const": true
                },
                "cooling_enabled": {
                  "const": false
                },
                "conditioning_state": {
                  "const": "heating_only"
                }
              }
            },
            {
              "properties": {
                "heating_enabled": {
                  "const": false
                },
                "cooling_enabled": {
                  "const": true
                },
                "conditioning_state": {
                  "const": "cooling_only"
                }
              }
            },
            {
              "properties": {
                "heating_enabled": {
                  "const": true
                },
                "cooling_enabled": {
                  "const": true
                },
                "conditioning_state": {
                  "const": "heating_and_cooling"
                }
              }
            }
          ]
        }
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
