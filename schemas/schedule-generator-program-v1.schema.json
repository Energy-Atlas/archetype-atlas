{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archetype-atlas:schedule-generator-program:1.0.0",
  "type": "object",
  "required": ["schema_version", "program_id", "recipe_id", "source_family", "source", "inputs", "slots", "demands", "controls", "shared_services", "evidence"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "program_id": {"$ref": "#/$defs/id"},
    "recipe_id": {"$ref": "#/$defs/id"},
    "source_family": {"$ref": "#/$defs/id"},
    "source": {
      "type": "object", "required": ["source_id", "building_type", "template", "vintage", "evidence_view", "climate", "weather"],
      "additionalProperties": false,
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "building_type": {"$ref": "#/$defs/id"},
        "template": {"type": ["string", "null"]},
        "vintage": {"type": ["string", "null"]},
        "evidence_view": {"$ref": "#/$defs/id"},
        "climate": {"type": ["string", "null"]},
        "weather": {"type": ["string", "object", "null"]}
      }
    },
    "inputs": {"type": "object", "additionalProperties": {"type": ["string", "number", "integer", "boolean", "object", "array", "null"]}},
    "slots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slot"}},
    "demands": {"type": "array", "items": {"$ref": "#/$defs/demand"}},
    "controls": {"type": "array", "items": {"$ref": "#/$defs/control"}},
    "shared_services": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "items": {"type": "object", "minProperties": 1}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "slot": {
      "type": "object", "required": ["slot", "source_schedule_id", "unit", "kind"],
      "additionalProperties": false,
      "properties": {
        "slot": {"$ref": "#/$defs/id"}, "source_schedule_id": {"$ref": "#/$defs/id"},
        "unit": {"$ref": "#/$defs/id"}, "kind": {"enum": ["load", "control", "resident_count"]}
      }
    },
    "annual_target": {
      "type": "object", "required": ["total", "unit", "evidence"], "additionalProperties": false,
      "properties": {"total": {"type": "number", "minimum": 0}, "unit": {"$ref": "#/$defs/id"},
        "evidence": {"type": "object", "minProperties": 1}}
    },
    "demand": {
      "type": "object", "required": ["demand_id", "slot", "quantity", "value", "unit", "basis", "fuel", "host", "evidence"],
      "additionalProperties": false,
      "properties": {
        "demand_id": {"$ref": "#/$defs/id"}, "slot": {"$ref": "#/$defs/id"},
        "quantity": {"$ref": "#/$defs/id"}, "value": {"type": ["number", "null"], "minimum": 0},
        "unit": {"$ref": "#/$defs/id"}, "basis": {"$ref": "#/$defs/id"},
        "fuel": {"$ref": "#/$defs/id"}, "host": {"$ref": "#/$defs/id"},
        "evidence": {"type": "object", "minProperties": 1},
        "annual_target": {"$ref": "#/$defs/annual_target"},
        "installed_rating": {"type": "object"},
        "capacity_constraint": {"type": "object", "required": ["maximum", "unit", "evidence"],
          "properties": {"maximum": {"type": "number", "minimum": 0}, "unit": {"$ref": "#/$defs/id"},
            "evidence": {"type": "object", "minProperties": 1}}, "additionalProperties": false}
      }
    },
    "control": {
      "type": "object", "required": ["slot", "quantity", "unit", "evidence"], "additionalProperties": false,
      "properties": {"slot": {"$ref": "#/$defs/id"}, "quantity": {"$ref": "#/$defs/id"},
        "unit": {"$ref": "#/$defs/id"}, "evidence": {"type": "object", "minProperties": 1}}
    }
  }
}
