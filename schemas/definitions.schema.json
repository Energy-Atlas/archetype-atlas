{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Element definition bundle 1.0.0",
  "type": "object",
  "required": ["schema_version", "programs", "constructions", "hvac_systems", "provenance", "source_files"],
  "properties": {"schema_version": {"const": "1.0.0"}},
  "$defs": {
    "record": {
      "type": "object",
      "required": ["id", "kind", "name", "building_type", "template", "source_family", "gate", "evidence_view", "derivation", "parameters", "evidence_ids", "required_inputs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["program", "construction", "hvac_system"]},
        "name": {"type": "string", "minLength": 1},
        "gate": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["residential", "nonresidential"]}},
        "evidence_view": {"enum": ["source", "reviewed"]},
        "derivation": {"enum": ["reported", "normalized", "composed", "assumed"]},
        "parameters": {"type": "object"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "required_inputs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
