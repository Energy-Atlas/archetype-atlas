{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archetype-atlas:schedule-generator-request:1.0.0",
  "type": "object",
  "required": [
    "resource_set_id",
    "calendar",
    "instances"
  ],
  "additionalProperties": false,
  "properties": {
    "resource_set_id": {
      "type": "string",
      "minLength": 1
    },
    "calendar": {
      "$ref": "#/$defs/calendar"
    },
    "instances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/instance"
      }
    },
    "mixture": {
      "$ref": "#/$defs/mixture"
    }
  },
  "$defs": {
    "calendar": {
      "type": "object",
      "required": [
        "year",
        "clock"
      ],
      "additionalProperties": false,
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "clock": {
          "const": "local_standard_time"
        },
        "holidays": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    },
    "instance": {
      "type": "object",
      "required": [
        "key",
        "program_id",
        "inputs",
        "basis_bindings",
        "operating_group"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "program_id": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object"
        },
        "basis_bindings": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "multiplicity": {
              "type": "number",
              "minimum": 0
            },
            "extents": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "floor_area": {
                  "$ref": "#/$defs/extent"
                },
                "dwelling_unit": {
                  "$ref": "#/$defs/extent"
                },
                "person": {
                  "$ref": "#/$defs/extent"
                },
                "absolute": {
                  "$ref": "#/$defs/extent"
                }
              }
            },
            "floor_area_m2": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "operating_group": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "mixture": {
      "type": "object",
      "required": [
        "program_id",
        "composition_id",
        "members"
      ],
      "additionalProperties": false,
      "properties": {
        "program_id": {
          "type": "string",
          "minLength": 1
        },
        "composition_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "instance_key",
              "weight"
            ],
            "additionalProperties": false,
            "properties": {
              "instance_key": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "result_basis": {
          "enum": [
            "floor_area",
            "dwelling_unit",
            "person",
            "absolute"
          ]
        },
        "denominator": {
          "$ref": "#/$defs/extent"
        }
      }
    },
    "extent": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "enum": [
            "m2",
            "dwelling",
            "person",
            "1"
          ]
        },
        "evidence": {
          "type": "object",
          "minProperties": 1
        }
      }
    }
  }
}
