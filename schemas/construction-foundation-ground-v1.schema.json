{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Embedded foundation configuration and native ground methods",
  "type": "object",
  "additionalProperties": false,
  "required": ["configuration", "methods", "model_parameters", "required_geometry"],
  "properties": {
    "configuration": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": {"enum": ["source_native_commercial", "Slab-on-Grade", "Basement, Conditioned", "Basement, Unconditioned", "Crawlspace, Vented", "Crawlspace, Unvented", "no_direct_ground_contact"]},
        "reason": {"type": "string", "minLength": 1},
        "thermal_hosts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "methods": {"type": "object", "additionalProperties": {"$ref": "#/$defs/method"}},
    "model_parameters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/modelParameters"}},
    "required_geometry": {
      "type": "object", "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["unit"],
        "properties": {
          "unit": {"enum": ["m", "m2", "m3", "1", "topology"]},
          "minimum": {"type": "number"}, "exclusive_minimum": {"type": "number"},
          "description": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "method": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "model_parameters_id", "parameters", "required_geometry"],
      "properties": {
        "model": {"enum": ["FFactor", "CFactor", "LayeredGround", "Kiva"]},
        "model_parameters_id": {"type": "string", "minLength": 1},
        "required_geometry": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "parameters": {"$ref": "#/$defs/kivaParameters"}
      },
      "allOf": [{"if": {"properties": {"model": {"enum": ["FFactor", "CFactor", "LayeredGround"]}}}, "then": {"properties": {"parameters": {"maxProperties": 0}}}}]
    },
    "kivaParameters": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "wall_depth_below_slab_m": {"type": "number", "minimum": 0},
        "wall_height_above_grade": {"$ref": "#/$defs/dimension"},
        "interior_horizontal_insulation": {"$ref": "#/$defs/insulation"},
        "interior_vertical_insulation": {"$ref": "#/$defs/insulation"},
        "exterior_horizontal_insulation": {"$ref": "#/$defs/insulation"},
        "exterior_vertical_insulation": {"$ref": "#/$defs/insulation"},
        "custom_blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}},
        "footing": {"$ref": "#/$defs/insulation"},
        "initialization": {
          "type": "object", "additionalProperties": false,
          "required": ["outdoor", "ground", "indoor", "offset_K"],
          "properties": {
            "outdoor": {"type": "number", "minimum": 0, "maximum": 1},
            "ground": {"type": "number", "minimum": 0, "maximum": 1},
            "indoor": {"type": "number", "minimum": 0, "maximum": 1},
            "offset_K": {"type": "number"}
          }
        }
      }
    },
    "dimension": {
      "oneOf": [
        {"type": "number"},
        {"type": "object", "additionalProperties": false, "required": ["geometry_input"], "properties": {"geometry_input": {"type": "string", "minLength": 1}}}
      ]
    },
    "insulation": {
      "type": "object", "additionalProperties": false, "required": ["material_id"],
      "properties": {
        "material_id": {"type": "string", "minLength": 1},
        "depth_m": {"$ref": "#/$defs/dimension"}, "width_m": {"$ref": "#/$defs/dimension"}
      }
    },
    "block": {
      "type": "object", "additionalProperties": false, "required": ["material_id", "depth_m", "x_m", "z_m"],
      "properties": {
        "material_id": {"type": "string", "minLength": 1}, "depth_m": {"$ref": "#/$defs/dimension"},
        "x_m": {"$ref": "#/$defs/dimension"}, "z_m": {"$ref": "#/$defs/dimension"}
      }
    },
    "modelParameters": {
      "type": "object", "additionalProperties": false, "required": ["model"],
      "properties": {
        "model": {"enum": ["FCBoundary", "LayeredGroundBoundary", "Kiva"]},
        "monthly_temperature_input": {"enum": ["fc_monthly_ground_temperature_C", "surface_monthly_ground_temperature_C"]},
        "soil_material_id": {"type": "string", "minLength": 1},
        "ground_solar_absorptivity": {"type": "number", "minimum": 0, "maximum": 1},
        "ground_thermal_absorptivity": {"type": "number", "minimum": 0, "maximum": 1},
        "ground_surface_roughness_m": {"type": "number", "minimum": 0},
        "far_field_width_m": {"type": "number", "exclusiveMinimum": 0},
        "deep_ground_boundary_condition": {"enum": ["ZeroFlux", "GroundWater"]},
        "deep_ground_depth_m": {"type": "number", "exclusiveMinimum": 0},
        "minimum_cell_dimension_m": {"type": "number", "exclusiveMinimum": 0},
        "maximum_cell_growth_coefficient": {"type": "number", "minimum": 1},
        "simulation_timestep": {"enum": ["Timestep", "Hourly"]},
        "initialization_policy": {"const": "resstock_source_start_month_1.0.0"},
        "heating_balance_temperature_C": {"type": "number"},
        "cooling_balance_temperature_C": {"type": "number"}
      },
      "allOf": [
        {"if": {"properties": {"model": {"enum": ["FCBoundary", "LayeredGroundBoundary"]}}}, "then": {"required": ["monthly_temperature_input"]}},
        {"if": {"properties": {"model": {"const": "Kiva"}}}, "then": {"required": ["soil_material_id", "ground_solar_absorptivity", "ground_thermal_absorptivity", "ground_surface_roughness_m", "far_field_width_m", "deep_ground_boundary_condition", "deep_ground_depth_m", "minimum_cell_dimension_m", "maximum_cell_growth_coefficient", "simulation_timestep", "initialization_policy", "heating_balance_temperature_C", "cooling_balance_temperature_C"]}}
      ]
    }
  }
}
