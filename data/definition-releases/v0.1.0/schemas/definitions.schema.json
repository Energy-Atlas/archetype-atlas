{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Element definition bundle 1.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "programs",
    "constructions",
    "hvac_systems",
    "provenance",
    "source_files",
    "materials",
    "components",
    "services",
    "compositions",
    "schedules",
    "policies",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "programs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "constructions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "hvac_systems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "compositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "schedules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "building_type",
        "template",
        "source_family",
        "gate",
        "evidence_view",
        "derivation",
        "parameters",
        "evidence_ids",
        "required_inputs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "program",
            "construction",
            "hvac_system"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "gate": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "residential",
              "nonresidential"
            ]
          }
        },
        "evidence_view": {
          "enum": [
            "source",
            "reviewed"
          ]
        },
        "derivation": {
          "enum": [
            "reported",
            "normalized",
            "composed",
            "assumed"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "value",
              "unit",
              "status",
              "evidence_id",
              "required_inputs"
            ],
            "properties": {
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "required_inputs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "status": {
                "enum": [
                  "known",
                  "unknown",
                  "not_reported",
                  "not_applicable",
                  "requires_input"
                ]
              }
            }
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
