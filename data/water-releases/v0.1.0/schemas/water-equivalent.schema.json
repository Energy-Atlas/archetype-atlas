      "const": "0.1.0"
    },
    "release_version": {
      "const": "0.1.0"
    },
    "base_release": {
      "const": "v0.2.0"
    },
    "program_id": {
      "const": "program-29f8fa7a1d5e5afcf1f0"
    },
    "building_type": {
      "const": "MediumOffice"
    },
    "template": {
      "const": "90.1-2013"
