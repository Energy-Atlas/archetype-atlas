    "evidence": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_locator",
          "source_revision",
          "source_file_sha256",
          "original_value",
          "original_unit",
          "transformation",
          "extraction_date",
          "interpretation_note"
