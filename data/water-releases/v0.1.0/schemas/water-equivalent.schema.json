        "schedule_type",
        "units",
        "time_resolution_minutes",
        "interpolation",
        "rules"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^water_schedule-[a-f0-9]{20}$"
        },
        "source_name": {
          "type": "string"
        },
        "schedule_type": {
          "const": "fraction"
        },
        "units": {
          "const": "dimensionless"
        },
        "time_resolution_minutes": {
          "const": 60
        },
        "interpolation": {
          "const": "none"
        },
        "rules": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "day_types",
              "start_date",
              "end_date",
              "type",
              "values",
              "source_index",
              "source_units",
              "source_category"
            ],
            "properties": {
              "day_types": {
                "type": "string",
                "minLength": 1
              },
              "start_date": {
                "type": "string",
                "minLength": 10
              },
              "end_date": {
                "type": "string",
                "minLength": 10
              },
              "type": {
                "const": "Hourly"
              },
              "values": {
                "type": "array",
                "minItems": 24,
                "maxItems": 24,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "source_index": {
                "type": "integer",
                "minimum": 0
              },
              "source_units": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "source_category": {
                "type": [
                  "null",
                  "string"
                ]
              }
            }
          }
        }
      }
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
