{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://energy-atlas.github.io/archetype-atlas/schemas/water-equivalent-0.1.0.json",
  "title": "Reviewed finite Medium Office fixture draw equivalent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allocation_weight",
    "base_release",
    "building_type",
    "conservation",
    "equivalent_peak_flow_m3_s_m2",
    "equivalent_schedule",
